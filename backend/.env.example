# Copy to .env for local runs and migrations (backend always loads .env first).
# Keep .env.develop / .env.prod as templates; CI copies the right one to .env on deploy.

ENV=develop

DB_SERVER=your-server.database.windows.net
DB_NAME=your-database
DB_USER=your-user
DB_PASSWORD=your-password
DB_DRIVER={ODBC Driver 18 for SQL Server}

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_BASE_URL=https://youraccount.blob.core.windows.net

# Prefer VITE_ZEPTO_BASE_URL in webapp/.env (see initializeEnvironment.js); optional override here:
ZEPTO_BASE_URL=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USERNAME=emailapikey
ZEPTO_API_TOKEN=
ZEPTO_FROM_EMAIL=
ZEPTO_FROM_NAME=Sniper Team
APP_LOGIN_URL=https://cleo-care-web-dev-ci-as.azurewebsites.net/login
ADMIN_NOTIFY_EMAIL=

AISENSY_API_KEY=
AISENSY_BASE_URL=
